{
  "name": "school-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/app/server.js",
    "start": "node --env-file-if-exists=.env src/app/server.js",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "node --env-file-if-exists=.env.test --experimental-test-coverage --test",
    "test:unit": "node --env-file-if-exists=.env.test --test ./tests/unit/**/*.test.js",
    "test:int": "node --env-file-if-exists=.env.test --test-concurrency=1 --experimental-test-coverage --test-force-exit --test ./tests/integration/**/*.test.js",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.js",
    "db:studio": "npx prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "eslint": "^9.10.0",
    "prettier": "^3.3.0",
    "prisma": "^6.0.0",
    "supertest": "^7.2.2"
  }
}
