# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:PORT/NAME_DATABASE

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Upstash Redis
UPSTASH_REDIS_REST_URL=YOUR_URL_REDIS
UPSTASH_REDIS_REST_TOKEN=YOUR_REDIS_TOKEN

# MAKE .env.test TOO WITH THIS IF YOU WANT TO TEST API