# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:PORT/NAME_DATABASE

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15
JWT_REFRESH_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Redis
REDIS_URL=YOUR_REDIS_URL

# MAKE .env.test FROM THIS FILE TO RUN THE TESTS.
# RUN A SEPARATE REDIS SERVER FOR DEV AND TEST (e.g. redis://localhost:6379 for dev,
# redis://localhost:6380 for test).
# IF BOTH ENVIRONMENTS SHARE ONE REDIS, CACHED RESPONSES LEAK BETWEEN THEM:
# THE API MAY RETURN DATA FROM WHICHEVER ENVIRONMENT WROTE THE CACHE FIRST,