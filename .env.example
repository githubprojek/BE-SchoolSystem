# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:PORT/NAME_DATABASE?connection_limit=15&pool_timeout=20

#Seed Admin for User
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
SEED_ALLOW_PRODUCTION=

# Reverse proxy — set to `1` if the app is behind Nginx/a proxy (MUST be set in production)
# Leave blank if the app is standalone without a proxy.
TRUST_PROXY=

# JWT
# Generate Each One JWT (BOTH SHOULD BE DIFFERENT KEY)
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# CORS
# Comma-separated allowed origins, e.g. https://your-frontend.com
# Leave empty to allow all origins (dev default; NOT recommended in production)
CORS_ORIGINS=

# Redis
REDIS_URL=YOUR_REDIS_URL

# MAKE .env.test FROM THIS FILE TO RUN THE TESTS.
# RUN A SEPARATE REDIS SERVER FOR DEV AND TEST (e.g. redis://localhost:6379 for dev,
# redis://localhost:6380 for test).
# IF BOTH ENVIRONMENTS SHARE ONE REDIS, CACHED RESPONSES LEAK BETWEEN THEM:
# THE API MAY RETURN DATA FROM WHICHEVER ENVIRONMENT WROTE THE CACHE FIRST,